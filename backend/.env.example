# ─── App Config ───────────────────────────────────────────
APP_NAME=ProcureGPT
APP_ENV=development
APP_PORT=8000
SECRET_KEY=procuregpt-dev-secret-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS (comma-separated origins) ──────────────────────
# For Railway production: CORS_ORIGINS=https://ai-procurement-gpt.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Database (MySQL) ────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=admin
MYSQL_DATABASE=procuregpt

# ─── LLM Providers ───────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_PROMPT_CACHING=True

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-2.5-flash

# Default LLM provider: anthropic, openai, or gemini
LLM_PROVIDER=anthropic

# ─── Email Provider ───────────────────────────────────────
# "smtp" for direct Gmail (EC2/local), "resend" for cloud (Railway)
EMAIL_PROVIDER=smtp

# SMTP config (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_NAME=ProcureGPT

# Resend config (used when EMAIL_PROVIDER=resend)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=your_verified_email@domain.com

# IMAP config (inbound email polling)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_app_password_here

# Email processing: polling | webhook | both
EMAIL_PROCESSING_MODE=polling
WEBHOOK_TOKEN=procuregpt-webhook-secret-2026

# ─── Embeddings ──────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── File Storage ────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# ─── LangSmith Tracing (optional) ────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=procuregpt
